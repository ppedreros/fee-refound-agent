          "run_id": {
            "format": "uuid",
            "title": "Run Id",
            "type": "string"
          },
          "steps": {
            "items": {
              "$ref": "#/components/schemas/StepView"
            },
            "title": "Steps",
            "type": "array"
          }
        },
        "required": [
          "run_id",
          "checked_at",
          "duration_ms",
          "cost_usd",
          "provider_mode",
          "steps"
        ],
        "title": "RunView",
        "type": "object"
      },
      "StandingView": {
        "properties": {
          "below_zero": {
            "items": {
              "$ref": "#/components/schemas/BelowZero"
            },
            "title": "Below Zero",
            "type": "array"
          },
          "ok": {
            "title": "Ok",
            "type": "boolean"
          }
        },
        "required": [
          "ok",
          "below_zero"
        ],
        "title": "StandingView",
        "type": "object"
      },
      "StepView": {
        "properties": {
          "latency_ms": {
            "title": "Latency Ms",
            "type": "integer"
          },
          "node": {
            "title": "Node",
            "type": "string"
          },
          "state": {
            "enum": [
              "finished",
              "failed"
            ],
            "title": "State",
            "type": "string"
          }
        },
        "required": [
          "node",
          "state",
          "latency_ms"
        ],
        "title": "StepView",
        "type": "object"
      },
      "SubAccountView": {
        "properties": {
          "available": {
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Available",
            "type": "string"
          },
          "balance": {
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Balance",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "type": {
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "name",
          "type",
          "balance",
          "available"
        ],
        "title": "SubAccountView",
        "type": "object"
      },
      "Topic": {
        "enum": [
          "fee_refund_request",
          "fee_question",
          "card_issue",
          "account_update",
          "statement_question",
          "other"
        ],
        "type": "string"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
