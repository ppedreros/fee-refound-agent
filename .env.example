# Copy to .env and adjust: cp .env.example .env   (.env is never committed)
# Every variable the code reads is listed here. Compose passes each service only what it needs.

# --- Database server (the db service) ---
POSTGRES_USER=fees
# Letters, digits and dashes only: compose puts this password inside OWNER_DATABASE_URL as is.
POSTGRES_PASSWORD=change-me
POSTGRES_DB=fees

# --- Database roles (created by the migrate job; see SPEC-data, "Database roles") ---
# The user in each URL must be the role shown; bootstrap sets that role's password from the URL.
# The API and the decision writer.
APP_DATABASE_URL=postgresql+psycopg://app_writer:change-me@db:5432/fees
# Read-only role for agent tools.
AGENT_DATABASE_URL=postgresql+psycopg://agent_reader:change-me@db:5432/fees
# Owner role, for `python -m backend.bootstrap` only. Compose builds it from POSTGRES_* and gives
# it to the migrate job alone, so leave it commented. Set it only to run bootstrap outside compose.
# OWNER_DATABASE_URL=postgresql+psycopg://fees:change-me@localhost:5432/fees

# --- Model providers ---
# Empty key: that provider runs in replay mode (real answers recorded earlier).
JEV_API_KEY=
OPENAI_API_KEY=
# auto (live when the key is present, replay when it isn't), live or replay.
PROVIDER_MODE=auto

# --- App ---
# Shadow mode only (D5). Must stay false.
AUTO_APPROVE_ENABLED=false
# Seeded identity of the person using the UI (Luis).
STAFF_ID=S07
# Per client, on every API route.
RATE_LIMIT=60/minute
# DEBUG, INFO, WARNING or ERROR.
LOG_LEVEL=INFO
# HMAC salt for hashing member ids in logs. Required; keep it secret.
MASKING_SALT=change-me
# Separate database for evals, on the same server and with the same roles.
EVAL_DATABASE_NAME=fees_eval

# --- Backend server, outside compose only (the image sets HOST=0.0.0.0) ---
# HOST=127.0.0.1
# PORT=8000
